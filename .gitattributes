# Line-ending policy for this repository.
#
# Text files are stored with LF inside git, and checked out with whatever
# each machine uses natively: CRLF on Windows, LF on macOS and Linux.
# Nobody has to configure anything, and a file edited on Windows no longer
# shows up as a whole-file rewrite when it is opened on a Mac.
#
# If a file ever does look fully rewritten again, run once:
#   git add --renormalize .

* text=auto

# Spelled out so nothing depends on git guessing.
*.html    text
*.css     text
*.js      text
*.json    text
*.md      text
*.svg     text
*.txt     text
*.xml     text
*.webmanifest text
CNAME     text
LICENSE   text
.nojekyll text

# Binary. Git must never touch the bytes of these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.avif    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.eot     binary
*.pdf     binary
*.zip     binary
*.mp4     binary
*.webm    binary
